{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window may call only Fortis' own commands. No plugin commands (clipboard is used from Rust only), no filesystem, no shell, no opener.",
  "windows": ["main"],
  "permissions": [
    "allow-vault-status",
    "allow-init-vault",
    "allow-unlock",
    "allow-lock",
    "allow-change-password",
    "allow-list-entries",
    "allow-get-entry",
    "allow-save-entry",
    "allow-delete-entry",
    "allow-totp",
    "allow-generate-password",
    "allow-copy-secret",
    "allow-copy-text"
  ]
}
