[Unit]
Description=Fortis Agent
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/fortis-agent
Restart=on-failure
RestartSec=5s
Environment=RUST_LOG=info

# Hardening (docs/deployment §1)
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
LimitCORE=0
UMask=0077

[Install]
WantedBy=default.target
